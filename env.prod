# Garmin Connect credentials
GARMIN_EMAIL=<your real email>
GARMIN_PASSWORD=<your real password>

# Garmin session token directory (created automatically). Default when unset: .garmin-tokens/
GARMINTOKENS=.garmin-tokens

# Rehab Platform server configuration
REHAB_PLATFORM_URL=<your real prod server url>
SHARED_SECRET=<your real shared secret>

# Polling configuration (seconds between polls)
POLL_INTERVAL=5

# Keep session warm between manual collections (45 minutes)
GARMIN_KEEPALIVE_INTERVAL=2700

# Health heartbeat for /admin on rehab-platform
COLLECTOR_HEALTH_INTERVAL=60
COLLECTOR_HEALTH_ENDPOINT=/api/collector/health
COLLECTOR_ID=mini-itx-prod

# Playwright recovery when JWT expires (keepalive / failed login)
GARMIN_BROWSER_LOGIN=1

# Use Google Chrome for Playwright (must match manual seeding; same .garmin-browser-profile)
GARMIN_PLAYWRIGHT_CHROME=1