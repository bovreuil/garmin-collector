# Garmin Connect credentials
GARMIN_EMAIL=your.email@example.com
GARMIN_PASSWORD=your_password

# Garmin session token directory (created automatically). Default when unset: .garmin-tokens/
# next to collector.py. On upstream ``react`` this holds e.g. garmin_tokens.json (JWT session), not Garth oauth files.
# Use a path inside this repo clone on both dev (Mac) and prod (mini-ITX). Gitignored — do not commit.
GARMINTOKENS=.garmin-tokens

# Rehab Platform server configuration
REHAB_PLATFORM_URL=http://localhost:5001
SHARED_SECRET=your_shared_secret_here

# Polling configuration (seconds between polls; production often ~30)
POLL_INTERVAL=60

# Session readiness (keepalive): proactive JWT refresh + wellness probe between collections.
# Interval: how often scheduled readiness runs (1800–2700 typical). Set 0 to disable.
GARMIN_KEEPALIVE_INTERVAL=0
# After a successful user collection, postpone the next readiness check (default 900s / 15 min).
# GARMIN_KEEPALIVE_POSTPONE_AFTER_COLLECT_SEC=900
# Pre-warm before jobs when last Garmin OK is older than this (default 1200s / 20 min).
# GARMIN_SESSION_STALE_SEC=1200

# Optional collector health heartbeat to rehab-platform (for admin UI status cards).
# - interval in seconds (set 0 to disable)
# - endpoint path on rehab-platform that accepts POST JSON payloads
# - collector id for display/grouping (defaults to hostname if unset)
COLLECTOR_HEALTH_INTERVAL=60
COLLECTOR_HEALTH_ENDPOINT=/api/collector/health
# COLLECTOR_ID=mini-itx-prod
# Deploy label in heartbeat JSON (default unknown). Often set by start script, not .env:
#   set COLLECTOR_VERSION=<git rev-parse --short HEAD>
# COLLECTOR_VERSION=

# Automatic browser re-auth (Playwright) when tokens are missing, expired (401), or password login returns 429.
# Allowed when GARMIN_BROWSER_LOGIN=1, OR when unset and sys.stdin.isatty() (many Task Scheduler + .bat setups still report a TTY).
#
# - unset: use TTY heuristic (default)
# - 1 / true / on: always allow collector-triggered browser (use if recovery never opens a browser on your host)
# - 0 / false / off: never auto-launch; run `python scripts/garmin_playwright_login.py --verify` yourself when needed
# GARMIN_BROWSER_LOGIN=1

# Use system Chrome for Playwright (collector subprocess + manual script); helps some SSO errors.
# On Windows, Chrome is the default when unset (must match how .garmin-browser-profile was seeded).
# GARMIN_PLAYWRIGHT_CHROME=1
# GARMIN_PLAYWRIGHT_CHROME=0

# Persistent browser profile for Playwright login (default: .garmin-browser-profile/ in repo).
# Reuses cookies/SSO trust between reseeds — often fewer Cloudflare challenges than a fresh context.
# GARMIN_PLAYWRIGHT_PROFILE=.garmin-browser-profile
# GARMIN_PLAYWRIGHT_EPHEMERAL=1

# After a failed automated browser reseed, suppress further Playwright attempts (seconds).
# Reduces 429/di-oauth-500 hammering when the persistent profile is stale. 0 = no cooldown.
# GARMIN_BROWSER_RESEED_COOLDOWN_SEC=1800
